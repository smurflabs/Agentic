[
  {
    "id": "agentic/axiom",
    "name": "Axiom",
    "description": "Engineering and reasoning router: code to a codex model, debugging to a fast deepseek, hard reasoning/math to deepseek-pro, vision and long context to gemini, small talk to the free local model.",
    "enabled": true,
    "definition": {
      "mode": "hybrid",
      "classifierModel": "qwen3.8-flash-MAX",
      "defaultModel": "dddai2/deepseek-v4-pro",
      "defaultFallbacks": ["dddai2/claude-sonnet-5"],
      "longContextTokens": 24000,
      "routes": [
        { "category": "coding",       "model": "dddai2/gpt-5.3-codex-spark", "fallbacks": ["dddai2/deepseek-v4-flash"] },
        { "category": "debugging",    "model": "dddai2/deepseek-v4-flash",   "fallbacks": ["dddai2/deepseek-v4-pro"] },
        { "category": "code_review",  "model": "dddai2/claude-sonnet-5",     "fallbacks": ["dddai2/deepseek-v4-pro"] },
        { "category": "devops",       "model": "dddai2/deepseek-v4-flash" },
        { "category": "data_sql",     "model": "dddai2/deepseek-v4-flash" },
        { "category": "reasoning",    "model": "dddai2/deepseek-v4-pro" },
        { "category": "math",         "model": "dddai2/deepseek-v4-pro" },
        { "category": "vision",       "model": "yqy/gemini-3.8-flash" },
        { "category": "long_context", "model": "yqy/gemini-3.8-flash" },
        { "category": "conversation", "model": "qwen3.8-flash-MAX" }
      ]
    }
  },
  {
