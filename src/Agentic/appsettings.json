      "TimeoutSeconds": 30,
      "MaxConcurrency": 8,
      "IdempotentTools": [ "current_time", "convert_time", "date_add", "date_diff", "calculate", "convert_units", "hash_text", "encode_text", "regex_test", "explain_cron", "text_stats", "text_diff", "transform_lines", "extract_patterns", "convert_case" ]
    },
    {
      "Id": "git",
      "Name": "Git (local repositories)",
