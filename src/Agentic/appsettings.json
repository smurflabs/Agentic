// Agentic configuration. Comments are allowed.
// Secrets NEVER go in this file:
//   AI key   -> environment variable AGENTIC_AIProviders__OpenWebUI__ApiKey
//   MCP auth -> the environment variable named in McpServers[].Auth.SecretEnvVar
// Any setting can be overridden with AGENTIC_<Section>__<Key> environment variables.
{
  "Host": {
    "InstanceName": "Agentic",
    "DataDirectory": "data",
    "ShutdownTimeoutSeconds": 30,
    "MaxAgents": 50
  },

  "Server": {
    "Enabled": true,
    "Host": "127.0.0.1",
    "Port": 8080,
    "MaxConcurrentRequests": 64,
    "MaxRequestBodyBytes": 1048576,
    "RequestTimeoutSeconds": 60,
    "SessionMinutes": 43200,
    // The address people reach this server at (share links made in the desktop app, VS Code or the CLI use it).
    "PublicUrl": "",
    "MaxSseClients": 500,
    "MaxSseClientsPerUser": 12
  },

  "Admin": {
    // Generate hashes with:  Agentic.exe --hash-password
    // With no users configured, a one-time bootstrap password for "admin" is printed on first start.
    "Users": [],
    // Bearer tokens for automation. Store only the SHA-256 (hex) of the token, or read it from an env var.
    // Scopes: admin | read | submit-task.  AllowedAgents empty = all agents.
    "ApiTokens": [],
    "MaxLoginAttemptsPerMinute": 10
  },

  "AIProviders": {
    "OpenWebUI": {
      "BaseUrl": "https://openwebui.example.com/api",
      "ApiKey": "",
      // Streaming keeps long reasoning responses alive behind Cloudflare (100 s idle limit).
      "UseStreaming": true,
      "TimeoutSeconds": 600,
      "ConnectTimeoutSeconds": 20,
      "ChatPath": "/chat/completions",
      "ModelsPath": "/models",
      "ImageGenerationPath": "/v1/images/generations",
      "MaxRetries": 2
    }
  },

  // Your own local models (the Models entries below with "IsLocal": true, e.g. llama.cpp servers): free for agents.
  //   Enabled: false = this server has no local models. local-main and local-vision are then dropped with every reference
  //            to them (ladders, spillover, agents), agents use the first model of the Default ladder, and global tasks
  //            (planned on local models only) are off.
  //   Slots:   requests each local model server works on at once (its parallel slots); 0 = each model's MaxConcurrency.
  //   SlotsByModel: slots for one model, e.g. { "local-vision": 2 }.
  // From the environment (Docker): AGENTIC_LocalModels__Enabled=false, AGENTIC_LocalModels__Slots=2,
  // AGENTIC_LocalModels__SlotsByModel__local-vision=2.
  "LocalModels": {
    "Enabled": true,
    "Slots": 4,
    "SlotsByModel": {}
  },

  // Cloud model prices are USD per 1M tokens. A cloud model with no price is NOT used (fail closed).
  // Set real prices here or in the dashboard (Finance -> Pricing).
  "Models": [
    {
      "Key": "local-main",
      "ModelId": "REAPER-40B-A3B",
      "Description": "Local REAPER-40B-A3B - default thinking model for every agent. No vision.",
      "Tier": 1,
      "IsLocal": true,
      "Capabilities": [ "ToolCalling", "Reasoning", "Streaming" ],
      "AllowedPurposes": [ "GeneralReasoning", "Planning", "Classification", "Extraction", "Summarization", "ToolSelection",
                           "CodeGeneration", "AdvancedCoding", "ReverseEngineering", "ComplexAnalysis", "ComplexLanguage", "Research" ],
      "MaxTokens": 16384,
      "Temperature": 0.3,
      "TimeoutSeconds": 600,
      "ContextWindowTokens": 262144,
      "MaxConcurrency": 4,
      "Fallbacks": [ "local-vision" ]
    },
    {
      // Local A1 (vision). Listed for its slots (LocalModels.Slots): chat requests queue for them like REAPER's (it is in
      // no routing ladder, so agents only use it where a model is chosen explicitly).
      "Key": "local-vision",
      "ModelId": "Agents-A1-35B-VISION",
      "Description": "Local Agents-A1-35B-VISION - vision and text. Its slots are shared by chat and agents; shares agent text work with local-main (one slot kept for vision and chat).",
      "Tier": 1,
      "IsLocal": true,
      "Capabilities": [ "ToolCalling", "Vision", "Reasoning", "Streaming" ],
      "AllowedPurposes": [ "Vision", "GeneralReasoning", "Planning", "Classification", "Extraction", "Summarization", "ToolSelection",
                           "CodeGeneration", "AdvancedCoding", "ReverseEngineering", "ComplexAnalysis", "ComplexLanguage", "Research" ],
      "MaxTokens": 32768,
      "Temperature": 0.3,
      "TimeoutSeconds": 600,
      "ContextWindowTokens": 262144,
      "MaxConcurrency": 4
    },
    // Cloud models (2026-10-30 audit, Model Square prices in USD per 1M tokens). Every tier has fallbacks at other
    // providers (sev, yqy, dddai), tried in order when one fails or its circuit is open, so an agent always has a model.
    // A fallback stands in for its primary: any agent that may use the primary may use it.
    {
      "Key": "coding-t2",
      "ModelId": "sev/deepseek-v4.1-flash-1017",
      "Description": "Tier 2 coding: harder coding than the local model can handle. SEV DeepSeek V4.1 Flash: cheapest and most reliable (2,650 calls, 1 failure).",
      "Tier": 2,
      "Capabilities": [ "ToolCalling", "Streaming" ],
      "AllowedPurposes": [ "CodeGeneration", "AdvancedCoding", "ReverseEngineering", "GeneralReasoning", "Planning", "Extraction", "ToolSelection" ],
      "MaxTokens": 8192,
      "Temperature": 0.2,
      "TimeoutSeconds": 600,
      "ContextWindowTokens": 128000,
      "MaxConcurrency": 8,
      "Fallbacks": [ "coding-t2-alt", "coding-t2-alt2" ],
