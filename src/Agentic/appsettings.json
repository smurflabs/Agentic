  "Limits": {
    "MaxConcurrentAIRequests": 16,
    "MaxConcurrentMcpCalls": 16,
    "MaxConcurrentAgentMessages": 32,
    "MaxDatabaseOperations": 16,
    "MaxArtifactBytes": 20971520,
    // Largest file an administrator can attach to a task (MB).
    "MaxUploadMb": 50,
    "MaxArtifactStoragePerAgentMb": 500
  },

  "Supervision": {
    "HeartbeatIntervalSeconds": 10,
    "StuckAfterSeconds": 1200,
    "WatchdogIntervalSeconds": 15,
    "AutoRestart": true,
