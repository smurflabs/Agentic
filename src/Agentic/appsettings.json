      "Name": "Utilities",
      "Description": "Exact helpers for every agent: time zones, date math, exact decimal calculator, unit conversion, hashes, encodings (base64/URL/hex/JWT), UUIDs, regex tests, secure passwords and secrets, random numbers and picks, cron explained, and text tools (counts, diff, line operations, extraction, case).",
      "Enabled": true,
      "Transport": "Stdio",
      "Command": "{self}",
