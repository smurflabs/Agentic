    },
    {
      "Key": "language-t2-alt2",
      "ModelId": "dddai/claude-haiku-4-5",
      "Description": "language-t2 at dddai: Claude Haiku 4.5.",
      "Tier": 2,
      "Capabilities": [ "ToolCalling", "Reasoning", "Streaming" ],
      "AllowedPurposes": [ "GeneralReasoning", "Planning", "Classification", "Extraction", "Summarization", "ToolSelection",
                           "ComplexAnalysis", "ComplexLanguage", "Research" ],
      "MaxTokens": 8192,
      "Temperature": 0.3,
      "TimeoutSeconds": 600,
      "ContextWindowTokens": 200000,
      "MaxConcurrency": 8,
      "Fallbacks": [ "language-t2", "language-t2-alt" ],
      "Pricing": { "InputPerMillion": 0.037, "OutputPerMillion": 0.184 }
    },
    {
      "Key": "expert-t3",
      "ModelId": "dddai/claude-sonnet-5",
      "Description": "Tier 3 expert: advanced coding, reverse engineering, hardest work; sees images. Claude Sonnet 5 at dddai (95 calls, no failures).",
      "Tier": 3,
      "Capabilities": [ "ToolCalling", "Reasoning", "Vision", "Streaming" ],
      "AllowedPurposes": [ "GeneralReasoning", "Planning", "CodeGeneration", "AdvancedCoding", "ReverseEngineering", "ComplexAnalysis",
                           "ComplexLanguage", "Research", "Extraction", "Summarization", "ToolSelection", "Classification", "Vision" ],
      "MaxTokens": 16384,
