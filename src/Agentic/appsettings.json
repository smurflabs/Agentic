    {
      "Key": "language-t2-alt",
      "ModelId": "yqy/glm-5.3-flash",
      "Description": "language-t2 at yqy: GLM 5.3 Flash.",
      "Tier": 2,
      "Capabilities": [ "ToolCalling", "Reasoning", "Streaming" ],
      "AllowedPurposes": [ "GeneralReasoning", "Planning", "Classification", "Extraction", "Summarization", "ToolSelection",
                           "ComplexAnalysis", "ComplexLanguage", "Research" ],
      "MaxTokens": 8192,
      "Temperature": 0.3,
      "TimeoutSeconds": 600,
      "ContextWindowTokens": 128000,
      "MaxConcurrency": 8,
      "Fallbacks": [ "language-t2", "language-t2-alt2" ],
