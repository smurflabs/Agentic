  "Communication": {
    "Enabled": true,
    "MaxMessageCharacters": 100000,
    "MaxStructuredPayloadBytes": 65536,
    "MaxAttachments": 10,
    "MaxDelegationDepth": 5,
    "MaxCommunicationChainLength": 12,
    "MaxChildTasksPerTask": 10,
    "MaxMessagesPerCorrelation": 200,
    "MaxMessagesPerMinute": 100,
    "MaxRequestsPerMinute": 30,
    "MaxDelegationsPerHour": 60,
    "MaxOutstandingRequests": 10,
    "MaxMailboxSize": 500,
    "MaxAgentToAgentWaitSeconds": 14400,
    "MinAgentToAgentWaitSeconds": 3600,
    "InlineWaitSeconds": 20,
    "DefaultMessageTtlMinutes": 1440,
    "AllowCycleRevisit": false,
    "RecordInformationAsMemory": true,
