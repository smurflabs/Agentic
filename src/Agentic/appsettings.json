  // Chat: the context window per model (any part of the model id), over the built-in sizes. Chats are compacted and
  // tool output is trimmed to stay inside it.
  "Chat": {
    "ContextWindows": { "REAPER-40B-A3B": 262144, "Agents-A1-35B-VISION": 262144 }
  },

  "Routing": {
    // Escalation ladders: index 0 = default model, each later entry = one escalation step.
    "Ladders": {
      "Default": [ "local-main", "language-t2", "expert-t3" ],
      "ComplexLanguage": [ "local-main", "language-t2", "expert-t3" ],
      "ComplexAnalysis": [ "local-main", "language-t2", "expert-t3" ],
      "Research": [ "local-main", "language-t2", "expert-t3" ],
      "CodeGeneration": [ "local-main", "coding-t2", "expert-t3" ],
      "AdvancedCoding": [ "local-main", "coding-t2", "expert-t3" ],
      "ReverseEngineering": [ "local-main", "coding-t2", "expert-t3" ]
    },
    // Agent tasks are shared between local-main and local-vision (LocalBalance: fewest tasks per slot, a task stays on its
    // model while it has a free slot). When the local slots are busy: wait (by priority), then spill to the cheapest
    // affordable cloud model.
    "Spillover": {
      "Enabled": true,
      "FromModel": "local-main",
      "Candidates": [ "vision", "coding-t2", "language-t2" ],
      "LocalCandidates": [ "local-vision" ],
      "LocalKeepFreeSlots": 1,
      "CriticalAfterSeconds": 5,
      "HighAfterSeconds": 15,
      "NormalAfterSeconds": 45,
      "LowAfterSeconds": 120,
      "QueueTimeoutSeconds": 900,
      "AgingSeconds": 120
    },
    "Escalation": {
      "Enabled": true,
      "OnModelUnavailable": true,
      "OnTruncation": true,
      "OnTurnLimit": true,
      "OnRetry": true,
      "AllowModelRequest": true,
      "MaxEscalationsPerTask": 2
    }
  },

  "Vision": {
    "Enabled": true,
    "ModelKeys": [ "vision", "vision-alt", "vision-alt2" ],
    "ExpertModelKeys": [ "expert-t3" ],
    "MaxImageBytes": 8388608,
    "MaxTokens": 1500
  },

  // Pictures (chats, agents, /v1/images/generations) come ONLY from this images API - never from OpenWebUI.
  // POST {BaseUrl}/images/generations; Model first, then FallbackModels when it cannot make the picture.
  // The key comes from the environment: AGENTIC_ImageGeneration__ApiKey. No BaseUrl or key = no image generation.
  "ImageGeneration": {
    "Enabled": true,
    "BaseUrl": "https://yuanqiaoyun.com/v1",
    "ApiKey": "",
    "Model": "gpt-image-2",
    "FallbackModels": [ "gpt-image-2.5-flare", "gpt-image-2.5-sunburst" ],
    // true = also try the API's other image models (from its /models list) after these.
    "AutoFallback": false,
    "DefaultSize": "1024x1024",
    "AllowedSizes": [ "1024x1024", "1280x720", "720x1280", "1152x864", "864x1152", "1248x832", "832x1248" ],
    "TimeoutSeconds": 240,
    "PricePerImage": null,
    "MaxConcurrency": 2,
    "MaxPerAgentPerDay": 25
  },

  // Deposits (Balance → Deposit): an account picks a whole amount (MinDeposit..MaxDeposit), a BTCPay invoice is made
  // (Greenfield API) and BTCPay's checkout is shown. BTCPay's webhook goes to your payment server, which then calls
  // POST /api/payments/deposit with header "X-Payment-Key: <DepositApiKey>" and body {"invoiceId": "..."} (optional
  // "username" and "amount" in USD). Each invoice is credited once. The API key is better kept in AGENTIC_Payments__ApiKey.
  "Payments": {
    "Enabled": true,
    "BtcPayUrl": "https://btcpay.example.com",
    "StoreId": "",
    "ApiKey": "",
    "Currency": "USD",
    "MinDeposit": 1,
    "MaxDeposit": 500,
    "NotificationUrl": "",
    "RedirectUrl": ""
  },

  // Videos (the Video button in Chat) come ONLY from this video API (new-api task routes, e.g. Seedance):
  // POST {BaseUrl}/video/generations starts a task, GET {BaseUrl}/video/generations/{id} follows it.
  // The key comes from the environment: AGENTIC_VideoGeneration__ApiKey.
  "VideoGeneration": {
    "Enabled": true,
    "BaseUrl": "https://yuanqiaoyun.com/v1",
    "ApiKey": "",
    "Model": "seedance-2.0-fast",
    "FallbackModels": [ "seedance-2.0-mini" ],
    "DefaultSeconds": 5,
    "MaxSeconds": 10,
    "Resolution": "720p",
    "DefaultRatio": "16:9",
    "TimeoutSeconds": 900,
    "PollSeconds": 5,
    "MaxConcurrency": 2,
    "MaxVideoMb": 200,
    // USD per second of video charged to User accounts (null = free); ModelPricePerSecond overrides it per model.
    "PricePerSecond": null,
    "ModelPricePerSecond": {}
  },

  // Speech (Read aloud and Dictation mode in Chat, the Audio tab) from a self-hosted XTTS-v2 server. Its key: Audio tab ->
  // Settings (kept in the vault as ApiKeySecret), or AGENTIC_TextToSpeech__ApiKey, which wins. Empty BaseUrl: browser voices only.
  "TextToSpeech": {
    "Enabled": true,
    "BaseUrl": "",
    "ApiKey": "",
    "ApiKeySecret": "xtts-api-key",
    "DefaultSpeaker": "Ana Florence",
    "DefaultLanguage": "en",
    // Requests the server works on at once; every other request (tabs, chat, API) waits in line here, first come first served.
    "MaxConcurrency": 1,
    "TimeoutSeconds": 1800,
    "MaxTextChars": 20000,
    "MaxCloneClipMb": 25,
    "MaxClipsPerUser": 200,
    // The model that writes Dictation mode's spoken summary when the voice's personality names none (empty: the answer's model).
    "SummaryModel": "",
    "SummaryWords": 60,
    // Starting prices for User accounts (USD; null = free): text in per 1M characters, audio out per minute, each voice
    // upload (clone or renewal). Administrators change them on the Audio tab or Finance.
    "PricePerMillionChars": null,
    "PricePerMinute": null,
    "PricePerVoiceUpload": null
  },

  // Pictures (the Images tab) from a self-hosted Stable Diffusion 1.5 server. Its key: Images tab -> Settings (kept in the
  // vault as ApiKeySecret), or AGENTIC_StableDiffusion__ApiKey, which wins. Empty BaseUrl: the Images tab is off.
  "StableDiffusion": {
    "Enabled": true,
    "BaseUrl": "",
    "ApiKey": "",
    "ApiKeySecret": "sd-api-key",
    "PollMilliseconds": 1000,
    // The server makes one job at a time: later jobs (and preprocessor runs) wait in line here and are sent in turn.
    "MaxConcurrency": 1,
    // Counted from when a job is sent to the server (waiting in line does not count).
    "JobTimeoutSeconds": 3600,
    "MaxActiveJobsPerUser": 3,
    "MaxImagesPerUser": 500,
    "MaxInputImageMb": 20,
    // Starting prices for User accounts (USD; null = free): per picture, and per minute the GPU worked on the job.
    "PricePerImage": null,
    "PricePerGpuMinute": null
  },

  // Songs (the Music tab) from the Suno API wrapper (Desktop\suno\server.py, the SunoAPI boot task). Its key is the
  // wrapper's api_key.txt: Music tab -> Settings (kept in the vault as ApiKeySecret), or AGENTIC_Music__ApiKey, which wins.
  // Empty BaseUrl: the Music tab is off.
  "Music": {
    "Enabled": true,
    "BaseUrl": "",
    "ApiKey": "",
    "ApiKeySecret": "suno-api-key",
    "PollSeconds": 5,
    "JobTimeoutSeconds": 900,
    "MaxActiveJobsPerUser": 2,
    "MaxSongsPerUser": 300,
    "DefaultModel": "chirp-goose",
    "Models": { "chirp-goose": "v6 mini" },
    // Starting prices for User accounts (USD; null = free): per song made (a request makes two), and per lyrics written by AI.
    "PricePerSong": null,
    "PricePerLyrics": null
  },

  // RAG (Retrieval-Augmented Generation) for the Chat tab: named knowledge bases built from uploaded files, their text
  // chunked and embedded, and the chunks most like the question retrieved as cited context. Needs an EMBEDDING MODEL on
  // the provider: set EmbeddingModel to its id (e.g. "bge-m3", "text-embedding-3-small"), or leave it empty to use the
  // first provider model whose id looks like an embedding model. Without one, the Knowledge button is hidden.
  "Rag": {
    "Enabled": true,
    "EmbeddingModel": "",
    "ChunkChars": 1800,
    "ChunkOverlap": 250,
    "TopK": 6,
    "MinScore": 0.15,
    "MaxContextChars": 12000,
    "EmbedBatch": 32,
    "MaxChunksPerBase": 60000,
    "MaxDocChars": 4000000,
    "TimeoutSeconds": 120
  },

  // Queue scheduling. Tasks flagged OffPeak run only inside the window below (or when their deadline is near); a task whose
  // deadline is within DeadlineWindowMinutes jumps the queue. Start = End means no window (OffPeak tasks always run).
  "Scheduling": {
    "Enabled": true,
    "OffPeakStartHourUtc": 0,
    "OffPeakEndHourUtc": 6,
    "DeadlineWindowMinutes": 30
  },

  // How agents reach a human out-of-band (the notify_human tool). Email credentials come only from the env vars named here.
  "Notifications": {
    "Enabled": false,
    "Email": {
      "Enabled": false,
      "SmtpHost": "",
      "Port": 587,
      "UseStartTls": true,
      "FromAddress": "",
      "ToAddress": "",
      "UserEnvVar": "AGENTIC_SMTP_USER",
      "PasswordEnvVar": "AGENTIC_SMTP_PASSWORD"
    },
    // Incoming-webhook channels (Slack/Discord/Teams compatible: posts {"text": ...}). The first is the default.
    "Channels": []
  },

  // Autonomy switches. GoalsEnabled runs the standing-goal review loop; VerifyPasses adds N self-critique passes before a
  // successful complete_task is accepted (0 = off); AllowSelfModification lets agents propose behaviour changes (admin-approved).
  "Autonomy": {
    "GoalsEnabled": true,
    "GoalSweepSeconds": 120,
    "VerifyPasses": 0,
    "AllowSelfModification": true,
    "MaxTriggerPayloadChars": 8000
  },

  "Economy": {
    "Enabled": true,
    "Currency": "USD",
    "DefaultInitialBalance": 5.0,
    "GlobalDailyCloudLimit": 25.0,
    "RequirePricingForCloudModels": true,
    "UsageEstimateFloorRatio": 0.25,
    // Runway forecast: balance / average daily spend over the last RunwayWindowDays. Agents with less than LowRunwayDays
    // left are flagged on the dashboard and told in their prompts to prefer the free local model.
    "RunwayWindowDays": 7,
    "LowRunwayDays": 3,
    // An agent whose balance falls below BankruptcyThreshold (USD) dies: it is shut down until its wallet is funded again.
    "BankruptcyEndsAgent": true,
    "BankruptcyThreshold": 0.01
  },

  // Temporary subagents agents can spawn for parallel subtasks. They use the parent's models; local-model use is free,
  // cloud use is charged to the parent's wallet and capped per subagent. They end when the spawning task ends.
  "Subagents": {
    "Enabled": true,
    "MaxPerAgent": 3,
    "MaxTotal": 20,
    "MaxPerTask": 8,
    "DefaultTimeoutMinutes": 30,
    "MaxTimeoutMinutes": 240,
    "DefaultSpendCap": 0.50,
    "MaxSpendCap": 5.00,
    "RetainDays": 30
  },

  // Organizational learning. When an agent goes broke or becomes very profitable, the host studies the decisions that
  // led there (on the free local model) and shares the resulting lessons with every agent.
  "Learning": {
    "Enabled": true,
    "ModelKeys": [ "local-main" ],
    "StudyFailures": true,
    "BrokeThreshold": 0.05,
    "StudySuccesses": true,
    "MinRoi": 3.0,
    "MinProfit": 10.0,
    "LargeProfit": 50.0,
    "FailureCooldownHours": 24,
    "SuccessCooldownHours": 72,
    "WindowDays": 14,
    "RequireApproval": false,
    "MaxLessonsPerStudy": 5,
    "PromptLessons": 4,
    "PromptLessonChars": 1800,
    "AnalysisTimeoutSeconds": 600
  },

  // Built-in web search: agents with the search_web tool query this SearXNG instance's JSON API.
  // Agents only supply the query text; the URL is fixed here.
  // Web search asks these services in order, the next one when a service fails or finds nothing: "brave" (Brave Search
  // API, needs BraveApiKey), "bing" (no key) and "searxng" (UrlTemplate). Empty Order: brave, bing, searxng.
  "WebSearch": {
    "Enabled": true,
    "Order": [ "brave", "bing", "searxng" ],
    "BraveApiKey": "",
    "UrlTemplate": "http://192.168.1.20:8080/search?q={query}&format=json",
    "MaxResults": 8,
    "MaxSnippetChars": 400,
    "TimeoutSeconds": 20,
    "MaxConcurrency": 4,
    "SafeSearch": 1
  },

  // Global tasks: the host reads a request, plans which agents do which part (on the free local model), runs the steps
  // (passing results between dependent steps) and combines everything into one final answer.
  "GlobalTasks": {
    "Enabled": true,
    "PlannerModelKeys": [ "local-main" ],
    "MaxSteps": 8,
    "DefaultDeadlineMinutes": 240,
    "PlanningTimeoutSeconds": 600
  },
  // MCP servers. Agents see a server's tools only if the server is in their AllowedMcpServers.
  "McpServers": [
    {
      "Id": "code-exec",
      "Name": "Code execution (Open Terminal)",
      "Description": "Linux shell and file tools on the sandbox machine: run commands, read/write/search files, manage background processes.",
      "AgentInstructions": "git here is signed in to https://gitea.example.com as Agentic (credentials are stored; never print or copy them). Work on a Gitea repository in a clone: git clone https://gitea.example.com/<owner>/<repo>.git, edit and test in the clone, then git add, git commit, git push (and git tag + git push --tags for a release). Do not move code between the sandbox and Gitea through your own context, base64 or the Gitea file API.",
      // Off by default: needs an Open Terminal MCP server (Endpoint) and MCP_CODE_EXEC_TOKEN. Turn it on once that is set up (SETUP.md, section 6).
      "Enabled": false,
      "Transport": "Http",
      "Endpoint": "http://192.168.1.20:8004/mcp",
      "HttpMode": "StreamableHttp",
      "TimeoutSeconds": 180,
      "MaxConcurrency": 4,
      // Bearer token from the MCP_CODE_EXEC_TOKEN environment variable, or put it in "Secret" (the variable wins when set).
      "Auth": { "Type": "Bearer", "SecretEnvVar": "MCP_CODE_EXEC_TOKEN" },
      // These act on the human user's own terminal and file viewer, not the agent's sandbox, so agents never get them.
      "ExcludeTools": [ "read_user_terminal", "send_user_terminal_input", "display_file" ],
      // Read-only tools: safe to repeat automatically if the host restarts mid-call.
      "IdempotentTools": [ "list_files", "read_file", "grep_search", "match_files", "search_files", "glob_search", "list_processes", "get_process_status" ],
      // Wait for a command to finish so its output comes back in the same call (without it the result is "status: running"
      // and models re-run the command or poll get_process_status with a garbled id until they run out of turns).
      "DefaultArguments": { "run_command": { "wait": 60 }, "get_process_status": { "wait": 30 } },
      // Commands run in a terminal: without these, git log/branch/tag open a pager and git push/commit wait at a prompt or an
      // editor, and the command stays "running" forever (enough of them and the sandbox stops finishing any command).
      "DefaultEnv": { "run_command": { "PAGER": "cat", "GIT_PAGER": "cat", "MANPAGER": "cat", "SYSTEMD_PAGER": "cat", "AWS_PAGER": "cat",
                                       "GIT_TERMINAL_PROMPT": "0", "GIT_EDITOR": "true", "EDITOR": "true", "VISUAL": "true",
                                       "GIT_SSH_COMMAND": "ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new",
                                       "DEBIAN_FRONTEND": "noninteractive", "PIP_NO_INPUT": "1", "NPM_CONFIG_YES": "true", "PYTHONUNBUFFERED": "1" } },
      // Watchdog: "echo ok" every 5 min (at once after call timeouts). Two failed checks = not responding: agents' calls
      // fail at once instead of waiting 180 s each, and the connection is reset (a new session) until it answers. While it
      // stays down the checks slow down (30 s doubling to 10 min), and a check that never finished is stopped (kill_process).
      "HealthCheck": { "Tool": "run_command", "Arguments": { "command": "echo ok", "wait": "10" }, "Expect": "ok", "StopTool": "kill_process",
                       "IntervalSeconds": 300, "DownIntervalSeconds": 30, "DownMaxIntervalSeconds": 600, "TimeoutSeconds": 30, "FailuresBeforeRestart": 2, "TimeoutsBeforeCheck": 2 }
    },
    {
      "Id": "storage",
      "Name": "Shared storage",
      "Description": "Shared folder where agents leave files for each other (built into Agentic; files live in data\\shared).",
      "Enabled": true,
      "Transport": "Stdio",
      // Built in: {self} is this executable and {data} its data folder. The host starts the server itself.
      "Command": "{self}",
      "Arguments": [ "--mcp-storage", "{data}\\shared", "--max-file-mb", "20", "--quota-mb", "2048" ],
      "TimeoutSeconds": 60,
      "MaxConcurrency": 4,
      "IdempotentTools": [ "list_files", "read_file", "search_files", "grep", "storage_info" ]
    },
    {
      "Id": "shell",
      "Name": "Shell commands (this server)",
      "Description": "PowerShell and cmd commands on the Agentic host, starting in data\\workspace. Runs as the host's Windows account.",
      "Enabled": true,
      "Transport": "Stdio",
      "Command": "{self}",
      "Arguments": [ "--mcp-shell", "{data}\\workspace", "--timeout", "120", "--max-output-kb", "64" ],
      "TimeoutSeconds": 900,
      "MaxConcurrency": 2,
      "IdempotentTools": [ "shell_info" ],
      // Every command waits for an administrator's approval in the Inbox. Remove this line to let agents run commands freely.
      "ApprovalRequiredTools": [ "run_command" ]
    },
    {
      "Id": "code-review",
      "Name": "Code review",
      "Description": "Automated code review checks (security, reliability, maintainability), diffs and review checklists; reviews files in the shared storage.",
      "Enabled": true,
      "Transport": "Stdio",
      "Command": "{self}",
      "Arguments": [ "--mcp-code-review", "{data}\\shared" ],
      "TimeoutSeconds": 60,
      "MaxConcurrency": 4,
      "IdempotentTools": [ "review_code", "review_file", "diff_code", "review_checklist" ]
    },
    {
      "Id": "browser",
      "Name": "Web browser (Playwright)",
      "Description": "Headless Chrome controlled through Microsoft's Playwright MCP: open pages, read them, click, type, fill forms, take screenshots.",
      // Off by default: needs Node.js, tools\playwright-mcp and Chrome. Turn it on once that is set up (SETUP.md, section 6).
      "Enabled": false,
      "Transport": "Stdio",
      // Portable Node 22 and @playwright/mcp live in Agentic\\tools; the browser is the installed Google Chrome.
      "Command": "C:\\Agentic\\tools\\node\\node.exe",
      "Arguments": [ "C:\\Agentic\\tools\\playwright-mcp\\node_modules\\@playwright\\mcp\\cli.js", "--headless", "--browser", "chrome", "--isolated", "--output-dir", "{data}\\browser" ],
      "TimeoutSeconds": 120,
      "ConnectTimeoutSeconds": 60,
      // One shared browser: calls are serialized so agents do not click in each other's pages.
      "MaxConcurrency": 1,
      "IdempotentTools": [ "browser_snapshot", "browser_take_screenshot", "browser_tabs", "browser_console_messages", "browser_network_requests" ]
    },
    {
      "Id": "gitea",
      "Name": "Gitea (gitea.example.com)",
      "Description": "Your Gitea: repositories, files, branches, commits, tags, releases, issues, pull requests and reviews, labels, milestones, Actions, wiki, packages, projects, notifications and search, plus every other REST endpoint (settings, webhooks, branch protection, collaborators, teams, orgs) through api_find_endpoint / api_get / api_write / api_delete.",
      // Paste the bot account's access token into Auth.Secret (or set the GITEA_ACCESS_TOKEN environment variable), then set Enabled to true.
      "Enabled": false,
      "Transport": "Stdio",
      // Built in: Agentic runs the official gitea-mcp (Agentic\tools\gitea-mcp) behind one server and adds the api_* tools.
      "Command": "{self}",
      "Arguments": [ "--mcp-gitea", "--gitea-mcp", "C:\\Agentic\\tools\\gitea-mcp\\gitea-mcp.exe" ],
      // Optional: "GITEA_READONLY": "true" exposes only read tools; "GITEA_INSECURE": "true" accepts a self-signed certificate.
      "EnvironmentVariables": { "GITEA_HOST": "https://gitea.example.com" },
      // The token reaches the server as the GITEA_ACCESS_TOKEN environment variable, never on its command line.
      "Auth": { "Type": "Header", "HeaderName": "GITEA_ACCESS_TOKEN", "SecretEnvVar": "GITEA_ACCESS_TOKEN", "Secret": "" },
      "TimeoutSeconds": 120,
      "ConnectTimeoutSeconds": 60,
      "MaxConcurrency": 4,
      "IdempotentTools": [ "api_find_endpoint", "api_get", "actions_config_read", "actions_run_read", "attachment_read", "get_commit", "get_dir_contents", "get_file_contents",
                           "get_gitea_mcp_server_version", "get_latest_release", "get_me", "get_release", "get_repository_tree", "get_tag", "get_user_orgs", "issue_read",
                           "label_read", "list_branches", "list_commits", "list_issues", "list_my_repos", "list_org_repos", "list_pull_requests", "list_releases", "list_tags",
                           "milestone_read", "notification_read", "package_read", "project_read", "pull_request_read", "search_issues", "search_org_teams", "search_repos",
                           "search_users", "timetracking_read", "wiki_read" ],
      // Permanent deletions wait for an administrator's approval in the Inbox. Remove names here to let agents do them freely.
      "ApprovalRequiredTools": [ "delete_branch", "delete_tag", "delete_release", "package_write", "api_delete" ]
    },
    {
      "Id": "rea",
      "Name": "REA - reverse engineering",
      "Description": "Reverse-engineer native binaries, .NET/CLI assemblies, JavaScript/Electron apps, Android APKs, websites and firmware: decompile and disassemble, inspect functions, data types, strings, call targets and load images, and compare versions - with Evidence-backed results. Analysis engine: Ghidra (GHIDRA_INSTALL_DIR).",
      // Off by default: needs Node.js, tools\rea and Ghidra (GHIDRA_INSTALL_DIR). Turn it on once that is set up (SETUP.md, section 6).
      "Enabled": false,
      "Transport": "Stdio",
      // Portable Node 22 (Agentic\\tools\\node) runs rea-agents from Agentic\\tools\\rea; Ghidra is the analysis engine.
      "Command": "C:\\Agentic\\tools\\node\\node.exe",
      "Arguments": [ "C:\\Agentic\\tools\\rea\\node_modules\\rea-agents\\scripts\\rea.mjs", "--mcp" ],
      "EnvironmentVariables": { "GHIDRA_INSTALL_DIR": "C:\\Agentic\\ghidra_12.1.4_PUBLIC" },
      "TimeoutSeconds": 600,
      "ConnectTimeoutSeconds": 120,
      "MaxConcurrency": 2,
      // Read-only analysis tools: safe to repeat automatically if the host restarts mid-call.
      "IdempotentTools": [ "analyze", "inspect", "decompile", "function", "disassemble", "demangle_swift", "address_to_file_offset", "address_name", "capabilities", "doctor",
                           "inspect_native_load_image", "inspect_native_data_type", "inspect_native_instruction", "resolve_native_call_targets", "list_strings", "list_functions",
                           "evidence_export", "compare", "compare_application_versions", "compare_managed_members", "compare_source_to_bundle", "compare_web_screenshots" ],
      // Tools that launch or observe running apps, capture live scenarios or extract firmware wait for an administrator's approval in the Inbox.
      "ApprovalRequiredTools": [ "observe_native_ui", "capture_native_ui_scenario", "observe_native_calls", "extract_firmware", "observe_web_execution", "observe_web_session",
                                 "capture_web_screenshot", "capture_browser_scenario", "capture_electron_scenario", "observe_javascript_runtime", "capture_process_scenario" ]
