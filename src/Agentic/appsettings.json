      "MaxTokens": 8192,
      "Temperature": 0.2,
      "TimeoutSeconds": 600,
      "ContextWindowTokens": 128000,
      "MaxConcurrency": 8,
      "Fallbacks": [ "coding-t2", "coding-t2-alt2" ],
