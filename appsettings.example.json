  "Routing": {
    // Escalation ladders: index 0 = default model, each later entry = one escalation step.
    "Ladders": {
      "Default": [ "local-main", "language-t2", "expert-t3" ],
      "ComplexLanguage": [ "local-main", "language-t2", "expert-t3" ],
      "ComplexAnalysis": [ "local-main", "language-t2", "expert-t3" ],
      "Research": [ "local-main", "language-t2", "expert-t3" ],
      "CodeGeneration": [ "local-main", "coding-t2", "expert-t3" ],
      "AdvancedCoding": [ "local-main", "coding-t2", "expert-t3" ],
      "ReverseEngineering": [ "local-main", "coding-t2", "expert-t3" ]
    },
    // When the 4 local slots are busy: wait (by priority), then spill to the cheapest affordable cloud model.
    "Spillover": {
      "Enabled": true,
      "FromModel": "local-main",
      "Candidates": [ "vision", "coding-t2", "language-t2" ],
      "LocalCandidates": [],   // other local model keys that take text work while FromModel is full (e.g. a local vision model)
      "LocalKeepFreeSlots": 1,
      "CriticalAfterSeconds": 5,
      "HighAfterSeconds": 15,
      "NormalAfterSeconds": 45,
      "LowAfterSeconds": 120,
      "QueueTimeoutSeconds": 900,
      "AgingSeconds": 120
    },
    "Escalation": {
      "Enabled": true,
      "OnModelUnavailable": true,
      "OnTruncation": true,
      "OnTurnLimit": true,
      "OnRetry": true,
      "AllowModelRequest": true,
      "MaxEscalationsPerTask": 2
    }
  },

  "Vision": {
    "Enabled": true,
    "ModelKeys": [ "vision", "vision-alt", "vision-alt2" ],
    "ExpertModelKeys": [ "expert-t3" ],
    "MaxImageBytes": 8388608,
    "MaxTokens": 1500
  },

  // Uses the image engine configured inside OpenWebUI (currently OpenAI-compatible gpt-image-2).
  "ImageGeneration": {
    "Enabled": true,
    "Provider": "OpenWebUI",
    "Model": "gpt-image-2",
    "DefaultSize": "512x512",
    "AllowedSizes": [ "256x256", "512x512", "1024x1024" ],
    "TimeoutSeconds": 240,
    "PricePerImage": null,
    "MaxConcurrency": 2,
    "MaxPerAgentPerDay": 25
  },

  "Economy": {
    "Enabled": true,
    "Currency": "USD",
    "DefaultInitialBalance": 5.0,
    "GlobalDailyCloudLimit": 25.0,
    "RequirePricingForCloudModels": true,
    "UsageEstimateFloorRatio": 0.25,
    // Runway forecast: balance / average daily spend over the last RunwayWindowDays. Agents with less than LowRunwayDays
    // left are flagged on the dashboard and told in their prompts to prefer the free local model.
    "RunwayWindowDays": 7,
    "LowRunwayDays": 3,
    // An agent whose balance falls below BankruptcyThreshold (USD) dies: it is shut down until its wallet is funded again.
    "BankruptcyEndsAgent": true,
    "BankruptcyThreshold": 0.01
  },

  // Temporary subagents agents can spawn for parallel subtasks. They use the parent's models; local-model use is free,
  // cloud use is charged to the parent's wallet and capped per subagent. They end when the spawning task ends.
  "Subagents": {
    "Enabled": true,
    "MaxPerAgent": 3,
    "MaxTotal": 20,
    "MaxPerTask": 8,
    "DefaultTimeoutMinutes": 30,
    "MaxTimeoutMinutes": 240,
    "DefaultSpendCap": 0.50,
    "MaxSpendCap": 5.00,
    "RetainDays": 30
  },

  // Organizational learning. When an agent goes broke or becomes very profitable, the host studies the decisions that
  // led there (on the free local model) and shares the resulting lessons with every agent.
  "Learning": {
    "Enabled": true,
    "ModelKeys": [ "local-main" ],
    "StudyFailures": true,
    "BrokeThreshold": 0.05,
    "StudySuccesses": true,
    "MinRoi": 3.0,
    "MinProfit": 10.0,
    "LargeProfit": 50.0,
    "FailureCooldownHours": 24,
    "SuccessCooldownHours": 72,
    "WindowDays": 14,
    "RequireApproval": false,
    "MaxLessonsPerStudy": 5,
    "PromptLessons": 4,
    "PromptLessonChars": 1800,
    "AnalysisTimeoutSeconds": 600
  },

  // Built-in web search: agents with the search_web tool query this SearXNG instance's JSON API.
  // Agents only supply the query text; the URL is fixed here.
  // Web search asks these services in order, the next one when a service fails or finds nothing: "brave" (Brave Search
  // API, needs BraveApiKey), "bing" (no key) and "searxng" (UrlTemplate). Empty Order: brave, bing, searxng.
  "WebSearch": {
    "Enabled": true,
    "Order": [ "brave", "bing", "searxng" ],
    "BraveApiKey": "",
    "UrlTemplate": "http://192.168.1.20:8080/search?q={query}&format=json",
    "MaxResults": 8,
    "MaxSnippetChars": 400,
    "TimeoutSeconds": 20,
    "MaxConcurrency": 4,
    "SafeSearch": 1
  },

  // Global tasks: the host reads a request, plans which agents do which part (on the free local model), runs the steps
  // (passing results between dependent steps) and combines everything into one final answer.
  "GlobalTasks": {
    "Enabled": true,
    "PlannerModelKeys": [ "local-main" ],
    "MaxSteps": 8,
    "DefaultDeadlineMinutes": 240,
    "PlanningTimeoutSeconds": 600
  },
  // Updates for the desktop app and the CLI: builds in Directory (cli\agentic.exe, desktop\AgenticClient.exe + desktop\www\...),
  // published with tools\publish-clients.ps1. Clients check at start and every CheckIntervalMinutes.
  "Updates": {
    "Enabled": true,
    "Directory": "updates",
    "CheckIntervalMinutes": 360
  },
  // Chat tab (and the code it runs). Python, Node and shell code runs in the CodeServerId MCP server (it needs the
  // write_file and run_command tools); AllowLocalCodeExecution would run it on this machine instead (administrators only).
  "Chat": {
    "Enabled": true,
    "DefaultModel": null,
    "SystemPrompt": null,
    "TaskModel": null,
    "CodeServerId": "code-exec",
    "AllowLocalCodeExecution": false,
    "CodeTimeoutSeconds": 60,
    // Tool rounds are checked for progress, not counted to a stop: an answer whose calls keep bringing new results goes on;
    // one whose last stretch brought nothing new (repeats, failures) is asked to answer. A chat's own limit (/limits) is a stop.
    "MaxToolRounds": 24,         // the progress check, in tool rounds (ClientToolRounds 50 for the CLI, desktop app and VS Code)
    "MaxTotalToolRounds": 0,     // a fixed total per answer (0 = none: progress, Stop and the balance decide)
    "MaxWebSearches": 30,
    "MaxPageReads": 60,
    "HistoryMessages": 40,
    // Parallel agents: subagents started in one response run at the same time (per chat: Tool limits / `/parallel`).
    "MaxParallelSubagents": 6,
    "MaxParallelTools": 8,       // read-only calls of one round (reading/searching files) run together, up to this many
    "SubagentMaxRounds": 50,     // a subagent's progress check in steps: one still getting things done goes on; else warned 3 ahead, its last step is its report; `resume` continues it
    "SubagentMaxTotalRounds": 0, // a fixed total of subagent steps (0 = none)
    "ClientToolTimeoutSeconds": 14400, // longest wait for a tool on the user's computer (no shorter limit while it stays connected)
    "ApprovalTimeoutSeconds": 900,     // how long a tool call waits for the user's approval
    // Downloading files out of the code sandbox, and stopping long-lived things the host started there so they do not run forever.
    "Sandbox": {
      "AllowDownloads": true,          // the share_file chat tool and the Files browser (download sandbox files / zipped folders)
      "MaxDownloadMb": 100,            // a download travels base64 over MCP, so keep it modest
      "ReaperEnabled": true,           // stop idle/expired sandbox processes and containers the host started
      "ReaperIntervalMinutes": 10,
      "ProcessIdleMinutes": 120,       // a background process with no new output for this long is stopped (0 = never on idle)
      "ProcessMaxLifeMinutes": 1440,   // a background process is always stopped once this old (0 = no maximum)
      "ContainerMaxLifeMinutes": 1440, // a Docker container the host started is stopped once this old (0 = no maximum)
      "RemoveStoppedContainers": true, // docker rm after stopping, so containers do not pile up
      "ManageContainers": true,        // needs passwordless `sudo docker` in the sandbox; false = processes only
      // Compose projects are infrastructure and left alone by default. Only ad-hoc `docker run` containers (no Compose
      // project) are reaped. List a project here to let the reaper `docker compose down` it as well.
      "ManagedComposeProjects": [],
      // Container names or Compose projects the reaper must never stop (defense in depth for infrastructure).
      "NeverTouch": [],
      "NotifyOwner": true,             // tell the owner chat when one of its sandbox resources is stopped
      // App previews: a web app in a sandbox container opens at /container/{id}/ on this host's own port (only containers
      // started here, never infrastructure). The link is the key; it expires after PreviewHours.
      "Previews": true,
      "PreviewHost": null,             // where published ports are reached (null = the code server's host)
      "PreviewHours": 24,
      "PreviewIsolation": "sandbox",   // sandbox: isolated page (CSP sandbox), cannot use your session; none: trusted apps only
      "PreviewTransport": "auto",      // auto | direct | mcp (through the sandbox connection: no setup, no WebSockets)
      "PreviewPorts": ""               // host ports the sandbox host forwards here, e.g. "20000-20499": apps are told to publish there (direct, with WebSockets)
    }
  },
  // MCP servers. Agents see a server's tools only if the server is in their AllowedMcpServers.
  "McpServers": [
    {
      "Id": "code-exec",
      "Name": "Code execution (Open Terminal)",
      "Description": "Linux shell and file tools on the sandbox machine: run commands, read/write/search files, manage background processes.",
      "Enabled": true,
      "Transport": "Http",
      "Endpoint": "http://192.168.1.20:8004/mcp",
      "HttpMode": "StreamableHttp",
      "TimeoutSeconds": 180,
      "MaxConcurrency": 4,
      // Bearer token from the MCP_CODE_EXEC_TOKEN environment variable, or put it in "Secret" (the variable wins when set).
      "Auth": { "Type": "Bearer", "SecretEnvVar": "MCP_CODE_EXEC_TOKEN" },
      // These act on the human user's own terminal and file viewer, not the agent's sandbox, so agents never get them.
      "ExcludeTools": [ "read_user_terminal", "send_user_terminal_input", "display_file" ],
      // Read-only tools: safe to repeat automatically if the host restarts mid-call.
      "IdempotentTools": [ "list_files", "read_file", "grep_search", "match_files", "search_files", "glob_search", "list_processes", "get_process_status" ],
      // Wait for a command to finish so its output comes back in the same call (without it the result is "status: running"
      // and models re-run the command or poll get_process_status with a garbled id until they run out of turns).
      "DefaultArguments": { "run_command": { "wait": 60 }, "get_process_status": { "wait": 30 } },
      // Watchdog: "echo ok" every 5 min (at once after call timeouts). Two failed checks = not responding: agents' calls
      // fail at once instead of waiting 180 s each, and the connection is reset (a new session) until it answers.
      "HealthCheck": { "Tool": "run_command", "Arguments": { "command": "echo ok", "wait": "10" }, "Expect": "ok",
                       "IntervalSeconds": 300, "DownIntervalSeconds": 30, "TimeoutSeconds": 30, "FailuresBeforeRestart": 2, "TimeoutsBeforeCheck": 2 }
    },
    {
      "Id": "storage",
      "Name": "Shared storage",
      "Description": "Shared folder where agents leave files for each other (built into Agentic; files live in data\\shared).",
      "Enabled": true,
      "Transport": "Stdio",
      // Built in: {self} is this executable and {data} its data folder. The host starts the server itself.
      "Command": "{self}",
      "Arguments": [ "--mcp-storage", "{data}\\shared", "--max-file-mb", "20", "--quota-mb", "2048" ],
      "TimeoutSeconds": 60,
      "MaxConcurrency": 4,
      "IdempotentTools": [ "list_files", "read_file", "search_files", "grep", "storage_info" ]
    },
    {
      "Id": "shell",
      "Name": "Shell commands (this server)",
      "Description": "PowerShell and cmd commands on the Agentic host, starting in data\\workspace. Runs as the host's Windows account.",
      "Enabled": true,
      "Transport": "Stdio",
      "Command": "{self}",
      "Arguments": [ "--mcp-shell", "{data}\\workspace", "--timeout", "120", "--max-output-kb", "64" ],
      "TimeoutSeconds": 900,
