      "AllowedPurposes": [ "CodeGeneration", "AdvancedCoding", "ReverseEngineering", "GeneralReasoning", "Planning", "Extraction", "ToolSelection" ],
      "MaxTokens": 8192,
      "Temperature": 0.2,
      "TimeoutSeconds": 600,
      "ContextWindowTokens": 128000,
      "MaxConcurrency": 8,
      "Fallbacks": [ "coding-t2-alt", "coding-t2-alt2" ],
      "Pricing": { "InputPerMillion": 0.02, "OutputPerMillion": 0.02 }
    },
    {
      "Key": "coding-t2-alt",
      "ModelId": "yqy/glm-5.3-flash",
      "Description": "coding-t2 at yqy: GLM 5.3 Flash.",
      "Tier": 2,
      "Capabilities": [ "ToolCalling", "Streaming" ],
