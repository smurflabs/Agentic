# Copy to .env (git-ignored) and fill in. docker-compose.yml reads it.

# Your OpenAI-compatible model provider: its base URL and API key.
OPENWEBUI_BASE_URL=https://openwebui.example.com/api
OPENWEBUI_API_KEY=

# true when you run your own local model servers (set their ModelIds in /data/appsettings.json).
LOCAL_MODELS_ENABLED=false
# Requests each local model server works on at once.
LOCAL_MODEL_SLOTS=4

# Port on this machine, and the address people use to reach the server (for share links).
AGENTIC_PORT=8080
PUBLIC_URL=
